; 场景文件。中括号是一段的标题，下面的键=值属于这一段。本课程不逐条讲这种存盘格式。
[gd_scene load_steps=2 format=3]

; ext_resource 把外部文件登记进本场景。id 是本文件里的编号，path 用 res:// 表示从项目根目录算起。
[ext_resource type="Script" path="res://lessons/ch01-editor/scripts/editor_hello.gd" id="1_hello"]

; 根节点。script = ExtResource 使用上面的编号，把 editor_hello.gd 挂到这个节点上。
[node name="EditorHello" type="Node2D"]
script = ExtResource("1_hello")

; parent="." 表示挂在根节点下面。
[node name="UI" type="CanvasLayer" parent="."]

; parent="UI" 表示挂在 UI 下面。text 是窗口上的字。锚点等界面字段在第 13 章学。
[node name="Title" type="Label" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -40.0
offset_right = 360.0
offset_bottom = 40.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.929, 0.949, 0.961, 1)
theme_override_font_sizes/font_size = 48
text = "Chapter 1"
horizontal_alignment = 1
vertical_alignment = 1
