; 这一课要运行的关卡。中括号是一段的标题。本课程不逐条讲这种存盘格式。
[gd_scene load_steps=3 format=3]

; 登记关卡脚本。id 只在本文件内使用。
[ext_resource type="Script" path="res://lessons/ch02-nodes-and-scenes/scripts/level.gd" id="1_level"]

; 登记道具场景。后面的 instance=ExtResource 会把这棵树放进关卡，一份场景可以用多次。
[ext_resource type="PackedScene" path="res://lessons/ch02-nodes-and-scenes/scenes/coin.tscn" id="2_coin"]

; 根节点。script 挂上 level.gd。
[node name="Level" type="Node2D"]
script = ExtResource("1_level")
position = Vector2(100, -200)

; 两枚硬币的父节点。改这个节点的 position，两枚硬币会一起动，彼此间距不变。
[node name="Shelf" type="Node2D" parent="."]
position = Vector2(640, 360)

; instance 表示这个节点不是在这里新建的，而是 coin.tscn 的一次使用。position 是相对 Shelf 的位置。
[node name="CoinA" parent="Shelf" instance=ExtResource("2_coin")]
position = Vector2(-70, 0)

[node name="CoinB" parent="Shelf" instance=ExtResource("2_coin")]
position = Vector2(70, 0)

; 参照点，直接放在 Level 下面，不是实例。Shelf 移动时它留在原地。
[node name="Mark" type="Polygon2D" parent="."]
position = Vector2(640, 520)
color = Color(0, 0.62, 0.7, 1)
polygon = PackedVector2Array(-8, -8, 8, -8, 8, 8, -8, 8)

; 画面上的英文说明。锚点在第 13 章学。
[node name="UI" type="CanvasLayer" parent="."]

[node name="Title" type="Label" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -420.0
offset_top = -280.0
offset_right = 420.0
offset_bottom = -220.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.929, 0.949, 0.961, 1)
theme_override_font_sizes/font_size = 32
text = "Two coins share one parent"
horizontal_alignment = 1
vertical_alignment = 1
