; 场景文件。中括号是一段的标题。本课程不逐条讲这种存盘格式。
[gd_scene load_steps=3 format=3]

; ext_resource 登记本文件要用的外部资源。id 只在本文件内使用。
[ext_resource type="Script" path="res://lessons/ch07-sprites-and-transforms/scripts/stage.gd" id="1_stage"]
[ext_resource type="Texture2D" path="res://lessons/ch07-sprites-and-transforms/sprites/mark.png" id="2_mark"]

; 根节点。script 把 stage.gd 挂在这里。
[node name="Stage" type="Node2D"]
script = ExtResource("1_stage")

; 同一张图的第一份，画在后面。z_index 越小越先画。
; texture_filter = 1 是邻近过滤，放大后像素块还在。线性过滤是 2，边缘会糊。
; centered 为 true 时，position 指图片中心，旋转也绕中心。
[node name="Back" type="Sprite2D" parent="."]
z_index = 0
texture_filter = 1
position = Vector2(520, 380)
scale = Vector2(4, 4)
texture = ExtResource("2_mark")
centered = true

; 同一张图的第二份，叠在 Back 右半边的前面。flip_h 是水平翻转，modulate 的第四个数是不透明度。
[node name="Front" type="Sprite2D" parent="."]
z_index = 1
texture_filter = 2
position = Vector2(620, 380)
scale = Vector2(4, 4)
texture = ExtResource("2_mark")
centered = true
flip_h = true
modulate = Color(1, 1, 1, 1)

; 会移动、会旋转的父节点。它自己不画图。
[node name="Carrier" type="Node2D" parent="."]
position = Vector2(860, 360)

; 挂在 Carrier 下面。position 是相对父节点的局部偏移，不是相对窗口左上角。
; region_enabled 只显示纹理里的一块。Rect2 的四个数是左、上、宽、高，单位是纹理像素。
[node name="Rider" type="Sprite2D" parent="Carrier"]
z_index = 0
texture_filter = 1
position = Vector2(70, 0)
scale = Vector2(3, 3)
texture = ExtResource("2_mark")
centered = true
region_enabled = true
region_rect = Rect2(0, 0, 32, 64)

; visible 为 false 时不绘制。这个节点用来对照，运行时看不到它。
[node name="Hidden" type="Sprite2D" parent="."]
visible = false
position = Vector2(200, 200)
texture = ExtResource("2_mark")

; text 是窗口上的字。锚点在第 13 章学。
[node name="UI" type="CanvasLayer" parent="."]

[node name="Title" type="Label" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -420.0
offset_top = -300.0
offset_right = 420.0
offset_bottom = -240.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.929, 0.949, 0.961, 1)
theme_override_font_sizes/font_size = 32
text = "Chapter 7"
horizontal_alignment = 1
vertical_alignment = 1
