; 场景文件。中括号是一段的标题。本课程不逐条讲这种存盘格式。
[gd_scene load_steps=3 format=3]

; 登记两份脚本。id 只在本文件内使用。
[ext_resource type="Script" path="res://lessons/ch05-signals/scripts/beacon.gd" id="1_beacon"]
[ext_resource type="Script" path="res://lessons/ch05-signals/scripts/lamp.gd" id="2_lamp"]

[node name="Signals" type="Node2D"]
; connection 是编辑器里的一条信号连接，保存进场景文件。from 发出，to 接收，method 是接收方的函数。
[connection signal="pressed" from="UI/PingButton" to="Beacon" method="_on_ping_button_pressed"]
[connection signal="lit_changed" from="Beacon" to="Lamp" method="_on_beacon_lit_changed"]

; 发信号的节点。script 把 beacon.gd 挂在这里。
[node name="Beacon" type="Node" parent="."]
script = ExtResource("1_beacon")

; 听信号的节点。script 把 lamp.gd 挂在这里。
[node name="Lamp" type="Node2D" parent="."]
script = ExtResource("2_lamp")

; 灯的可见部分。parent 是 Lamp，所以灯的脚本用 $Bulb 找到它。
[node name="Bulb" type="Polygon2D" parent="Lamp"]
position = Vector2(640, 300)
color = Color(0.35, 0.38, 0.45, 1)
polygon = PackedVector2Array(-28, -28, 28, -28, 28, 28, -28, 28)

[node name="UI" type="CanvasLayer" parent="."]

; text 是窗口上的字。锚点在第 13 章学。
[node name="Title" type="Label" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -280.0
offset_right = 360.0
offset_bottom = -220.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.929, 0.949, 0.961, 1)
theme_override_font_sizes/font_size = 32
text = "Chapter 5"
horizontal_alignment = 1
vertical_alignment = 1

; 引擎自带的按钮。pressed 是它自己的信号，不是本课脚本声明的。
[node name="PingButton" type="Button" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -70.0
offset_top = 80.0
offset_right = 70.0
offset_bottom = 130.0
grow_horizontal = 2
grow_vertical = 2
text = "Ping"


