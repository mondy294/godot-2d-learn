; 习题场景。中括号是一段的标题。本课程不逐条讲这种存盘格式。
[gd_scene load_steps=3 format=3]

; 登记两份脚本。id 只在本文件内使用。
[ext_resource type="Script" path="res://lessons/ch05-signals/exercises/ex01-health/scripts/player.gd" id="1_player"]
[ext_resource type="Script" path="res://lessons/ch05-signals/exercises/ex01-health/scripts/health_bar.gd" id="2_bar"]

[node name="Health" type="Node2D"]

; 发出 health_changed 的节点。
[node name="Player" type="Node" parent="."]
script = ExtResource("1_player")

; 听 health_changed 的节点。
[node name="HealthBar" type="Node2D" parent="."]
script = ExtResource("2_bar")

; 血条的可见部分。初始宽度表示满生命。
[node name="Bar" type="Polygon2D" parent="HealthBar"]
position = Vector2(640, 300)
color = Color(0.85, 0.28, 0.32, 1)
polygon = PackedVector2Array(-150, -16, 150, -16, 150, 16, -150, 16)

[node name="UI" type="CanvasLayer" parent="."]

; text 是窗口上的字。锚点在第 13 章学。
[node name="Title" type="Label" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -280.0
offset_right = 360.0
offset_bottom = -220.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.929, 0.949, 0.961, 1)
theme_override_font_sizes/font_size = 32
text = "Exercise"
horizontal_alignment = 1
vertical_alignment = 1

[node name="HurtButton" type="Button" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -70.0
offset_top = 80.0
offset_right = 70.0
offset_bottom = 130.0
grow_horizontal = 2
grow_vertical = 2
text = "Hurt"

; connection 是已经接好的信号。from 发出，to 接收，method 是接收方的函数。
[connection signal="pressed" from="UI/HurtButton" to="Player" method="_on_hurt_button_pressed"]
[connection signal="health_changed" from="Player" to="HealthBar" method="_on_player_health_changed"]
