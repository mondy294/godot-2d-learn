; 习题场景。中括号是一段的标题。本课程不逐条讲这种存盘格式。
[gd_scene load_steps=2 format=3]

; ext_resource 登记脚本。id 只在本文件内使用。
[ext_resource type="Script" path="res://lessons/ch06-input/exercises/ex01-nudge/scripts/nudge.gd" id="1_nudge"]

[node name="Nudge" type="Node2D"]
script = ExtResource("1_nudge")

; parent="." 表示挂在根节点下面。
[node name="Token" type="Polygon2D" parent="."]
position = Vector2(640, 360)
color = Color(0.95, 0.76, 0.22, 1)
polygon = PackedVector2Array(-18, -18, 18, -18, 18, 18, -18, 18)

[node name="UI" type="CanvasLayer" parent="."]

; text 是窗口上的字。锚点在第 13 章学。
[node name="Title" type="Label" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -280.0
offset_right = 360.0
offset_bottom = -220.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.929, 0.949, 0.961, 1)
theme_override_font_sizes/font_size = 32
text = "Exercise"
horizontal_alignment = 1
vertical_alignment = 1
