; 场景文件。中括号是一段的标题。本课程不逐条讲这种存盘格式。
[gd_scene load_steps=2 format=3]

; ext_resource 登记脚本。id 只在本文件内使用，path 的 res:// 从项目根目录算起。
[ext_resource type="Script" path="res://lessons/ch04-script-lifecycle/scripts/life.gd" id="1_life"]

; 根节点类型是 Node2D，要和脚本第一行的 extends Node2D 一致。
[node name="Life" type="Node2D"]
script = ExtResource("1_life")

; parent="." 表示挂在根节点下面。脚本用 $Dot 找到它。
[node name="Dot" type="Polygon2D" parent="."]
position = Vector2(180, 360)
color = Color(0.93, 0.45, 0.4, 1)
polygon = PackedVector2Array(-18, -18, 18, -18, 18, 18, -18, 18)

; 界面层。锚点在第 13 章学。
[node name="UI" type="CanvasLayer" parent="."]

; 脚本用 $UI/Title 找到这个节点，并在 _ready 里打印它的名字 Title。
[node name="Title" type="Label" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -280.0
offset_right = 360.0
offset_bottom = -220.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.929, 0.949, 0.961, 1)
theme_override_font_sizes/font_size = 32
text = "Chapter 4"
horizontal_alignment = 1
vertical_alignment = 1
