; 场景文件。中括号是一段的标题。ext_resource 登记外部脚本，ExtResource 再把它挂到节点上。
[gd_scene load_steps=2 format=3]

; id 只在本文件内使用。path 的 res:// 从项目根目录算起。
[ext_resource type="Script" path="res://scripts/main/main.gd" id="1_main"]

[node name="Main" type="Node2D"]
script = ExtResource("1_main")

; parent="." 表示挂在根节点 Main 下面。
[node name="UI" type="CanvasLayer" parent="."]

; text 是窗口上的字。锚点等界面字段在第 13 章学。
[node name="Title" type="Label" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -360.0
offset_top = -56.0
offset_right = 360.0
offset_bottom = 8.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.929, 0.949, 0.961, 1)
theme_override_font_sizes/font_size = 48
text = "Godot 2D"
horizontal_alignment = 1
vertical_alignment = 1

; 第二行说明文字，同样挂在 UI 下面。
[node name="Hint" type="Label" parent="UI"]
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -460.0
offset_top = 20.0
offset_right = 460.0
offset_bottom = 64.0
grow_horizontal = 2
grow_vertical = 2
theme_override_colors/font_color = Color(0.69, 0.73, 0.78, 1)
theme_override_font_sizes/font_size = 22
text = "Project is ready. Start from docs/README.md"
horizontal_alignment = 1
